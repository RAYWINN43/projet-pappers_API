{% extends 'base.html.twig' %}

{% block title %}Recherche{% endblock %}

{% block body %}
<h1>Recherche</h1>

<form method="get" action="{{ path('enterprise_search') }}">
    <input type="text" name="q" value="{{ query }}" placeholder="Recherche">
    <button type="submit">Rechercher</button>
</form>

<table>
    <thead>
    <tr>
        <th>Numéro</th>
        <th>Status</th>
        <th>Forme juridique</th>
        <th>Dénomination</th>
    </tr>
    </thead>
    <tbody>
    {% for e in results %}
        {% set d = e.denominations[0] ?? null %}
        <tr>
            <td><a href="{{ path('enterprise_view', {num: e.enterpriseNumber}) }}">{{ e.enterpriseNumber }}</a></td>
            <td>{{ e.status }}</td>
            <td>{{ e.juridicalForm }}</td>
            <td>{{ d ? d.denomination : '' }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<a href="{{ path('home') }}" class="back-link">Retour accueil</a>
{% endblock %}
