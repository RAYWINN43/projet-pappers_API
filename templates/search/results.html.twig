{% extends 'base.html.twig' %}

{% block title %}Résultats{% endblock %}

{% block body %}
<div style="max-width:900px; margin:auto; padding-top:30px;">

    <div style="display:flex; justify-content:space-between; align-items:center;">
        <h2>Résultats pour "{{ query }}"</h2>

        <a href="{{ path('app_enterprise_add') }}" 
           style="padding:10px 15px; background:#2c7; color:white; text-decoration:none; border-radius:5px;">
            + Ajouter une entreprise
        </a>
    </div>

    {% if results is empty %}
        <p>Aucun résultat trouvé.</p>
    {% else %}
        <table width="100%" border="1" cellpadding="8" cellspacing="0" style="margin-top:20px;">
            <tr>
                <th>Numéro BCE</th>
                <th>Status</th>
                <th>Forme juridique</th>
                <th>Date début</th>
                <th>Dénominations</th>
                <th>Modifier</th>
                <th>Supprimer</th>
            </tr>

            {% for row in results %}
            <tr>
                <!-- CLICK = VOIR PAGE ENTREPRISE -->
                <td>
                    <a href="{{ path('app_enterprise_view', { id: row.id }) }}">
                        {{ row.EnterpriseNumber }}
                    </a>
                </td>

                <td>{{ row.Status }}</td>
                <td>{{ row.JuridicalForm }}</td>
                <td>{{ row.StartDate|date('d/m/Y') }}</td>

                <td>
                    {% for d in row.denominations %}
                        {{ d.Denomination }} <br>
                    {% endfor %}
                </td>

                <td>
                    <a href="{{ path('app_enterprise_edit', { id: row.id }) }}">Modifier</a>
                </td>

                <td>
                    <a href="{{ path('app_enterprise_delete', { id: row.id }) }}"
                       onclick="return confirm('Supprimer cette entreprise ?')">
                        Supprimer
                    </a>
                </td>
            </tr>
            {% endfor %}
        </table>
    {% endif %}

    <div style="margin-top:30px;">
        <a href="{{ path('app_home') }}">Nouvelle recherche</a>
    </div>

</div>
{% endblock %}
