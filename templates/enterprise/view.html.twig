{% extends 'base.html.twig' %}
{% block body %}
<h1>{{ enterprise.enterpriseNumber }}</h1>

<p>{{ enterprise.status }}</p>
<p>{{ enterprise.juridicalForm }}</p>
<p>{{ enterprise.startDate ? enterprise.startDate|date('d/m/Y') : '' }}</p>

<h2>Dénominations</h2>
<ul>
    {% for d in enterprise.denominations %}
        <li>{{ d.denomination }}</li>
    {% endfor %}
</ul>

<h2>Établissements</h2>
<ul>
    {% for est in enterprise.establishments %}
        <li>{{ est.establishmentNumber }} — {{ est.name }}</li>
    {% endfor %}
</ul>

<a href="{{ path('enterprise_edit', {num: enterprise.enterpriseNumber}) }}">Modifier</a>

<form method="post" action="{{ path('enterprise_delete', {num: enterprise.enterpriseNumber}) }}">
    <button>Supprimer</button>
</form>
{% endblock %}
