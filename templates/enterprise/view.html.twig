{% extends 'base.html.twig' %}

{% block title %}Entreprise {{ enterprise.enterpriseNumber }}{% endblock %}

{% block body %}
<h1>Entreprise {{ enterprise.enterpriseNumber }}</h1>

<p>Status : {{ enterprise.status }}</p>
<p>Forme juridique : {{ enterprise.juridicalForm }}</p>
<p>Date de début : {{ enterprise.startDate ? enterprise.startDate|date('d/m/Y') : '' }}</p>

<h2>Dénominations</h2>
<ul>
    {% for d in enterprise.denominations %}
        <li>{{ d.denomination }}</li>
    {% endfor %}
</ul>

<h2>Établissements</h2>
<ul>
    {% for est in enterprise.establishments %}
        <li>{{ est.establishmentNumber }} — {{ est.name }}</li>
    {% endfor %}
</ul>

<a href="{{ path('enterprise_edit', { num: enterprise.enterpriseNumber }) }}">Modifier</a>

<form method="post" action="{{ path('enterprise_delete', { num: enterprise.enterpriseNumber }) }}" style="margin-top: 20px;">
    <button type="submit">Supprimer</button>
</form>

<a href="{{ path('home') }}" class="back-link">Retour accueil</a>
{% endblock %}
