{% extends 'base.html.twig' %}

{% block title %}Entreprise {{ enterprise.EnterpriseNumber }}{% endblock %}

{% block body %}
<div style="max-width:800px; margin:auto; padding-top:20px;">

    <h1>Entreprise {{ enterprise.EnterpriseNumber }}</h1>

    <p>Status : {{ enterprise.Status }}</p>
    <p>Forme juridique : {{ enterprise.JuridicalForm }}</p>
    <p>Date début : {{ enterprise.StartDate ? enterprise.StartDate|date('d/m/Y') : '—' }}</p>

    <h3>Dénominations</h3>

    {% if enterprise.denominations is empty %}
    Aucune dénomination trouvée
    {% else %}
        {% for d in enterprise.denominations %}
            • {{ d.Denomination }} ({{ d.Language ?? '' }} - {{ d.TypeOfDenomination ?? '' }})<br>
        {% endfor %}
    {% endif %}

    <br><br>
    
    <a href="{{ path('app_enterprise_edit', { num: enterprise.EnterpriseNumber }) }}">
    Modifier cette entreprise
    </a>
    <br><br>


    <a href="{{ path('app_enterprise_delete', { num: enterprise.EnterpriseNumber }) }}" onclick="return confirm('Supprimer ?');">Supprimer</a>
    <br>
    <a href="{{ path('app_home') }}">Retour</a>

</div>
{% endblock %}
