{% extends 'base.html.twig' %}

{% block title %}Modifier {{ enterprise.enterpriseNumber }}{% endblock %}

{% block body %}
<h1>Modifier {{ enterprise.enterpriseNumber }}</h1>

<form method="post">
    <div>
        <label>Status</label>
        <input type="text" name="status" value="{{ enterprise.status }}">
    </div>

    <div>
        <label>Forme juridique</label>
        <input type="text" name="juridicalForm" value="{{ enterprise.juridicalForm }}">
    </div>

    <div>
        <label>Date de début</label>
        <input type="date" name="startDate" value="{{ enterprise.startDate ? enterprise.startDate|date('Y-m-d') : '' }}">
    </div>

    <h2>Dénomination</h2>

    <div>
        <label>Nom de la dénomination</label>
        <input type="text" name="denomination" value="{{ mainDenom ? mainDenom.denomination : '' }}">
    </div>

    <div>
        <label>Type</label>
        <input type="text" name="denominationType" value="{{ mainDenom ? mainDenom.typeOfDenomination : '' }}">
    </div>

    <div>
        <label>Langue</label>
        <input type="text" name="denominationLanguage" value="{{ mainDenom ? mainDenom.language : '' }}">
    </div>

    <button type="submit">Enregistrer</button>
</form>

<a href="{{ path('enterprise_view', { num: enterprise.enterpriseNumber }) }}">Retour</a>
{% endblock %}
