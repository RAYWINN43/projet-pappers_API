{% extends 'base.html.twig' %}

{% block title %}Ajouter une entreprise{% endblock %}

{% block body %}
<h1>Ajouter une entreprise</h1>

<form method="post">

    <div>
        <label>Numéro BCE</label>
        <input type="text" name="enterpriseNumber" required>
    </div>

    <div>
        <label>Status</label>
        <input type="text" name="status">
    </div>

    <div>
        <label>Forme juridique</label>
        <input type="text" name="juridicalForm">
    </div>

    <div>
        <label>Date de début</label>
        <input type="date" name="startDate">
    </div>

    <h2>Dénomination</h2>

    <div>
        <label>Nom</label>
        <input type="text" name="denomination">
    </div>

    <div>
        <label>Type</label>
        <input type="text" name="denominationType">
    </div>

    <div>
        <label>Langue</label>
        <input type="text" name="denominationLanguage">
    </div>

    <button type="submit">Enregistrer</button>
</form>

<a href="{{ path('home') }}" class="back-link">Retour accueil</a>
{% endblock %}
