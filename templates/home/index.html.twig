{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div style="max-width:700px; margin:auto; padding-top:40px;">

    <h1>Recherche d'entreprise</h1>

    <form action="{{ path('app_search') }}" method="get" style="margin-top:20px;">
        <input 
            type="text" 
            name="q" 
            placeholder="Nom ou Numéro BCE"
            required
            style="width:100%; padding:12px; font-size:18px;"
        >
        <button style="margin-top:15px; padding:12px 20px; width:100%; font-size:18px;">
            Rechercher
        </button>
    </form>

    <hr style="margin:30px 0;">

    <h2>5 premières entreprises</h2>

    <table width="100%" border="1" cellpadding="8" cellspacing="0" style="margin-top:15px;">
        <tr>
            <th>Numéro BCE</th>
            <th>Status</th>
            <th>Forme juridique</th>
            <th>Dénomination</th>
        </tr>

        {% for e in enterprises %}
        <tr>
            <td>
                <a href="{{ path('app_enterprise_view', { num: e.EnterpriseNumber }) }}">
                    {{ e.EnterpriseNumber }}
                </a>
            </td>

            <td>{{ e.Status }}</td>

            <td>{{ e.JuridicalForm }}</td>

            <td>
                {% if e.denominations is empty %}
                    Aucune
                {% else %}
                    {% for d in e.denominations %}
                        {{ d.Denomination }}<br>
                    {% endfor %}
                {% endif %}
            </td>
        </tr>
        {% endfor %}
    </table>

</div>
{% endblock %}
