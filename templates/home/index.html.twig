{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<div style="max-width:700px; margin:auto; padding-top:40px;">

    <h1>Recherche d'entreprise</h1>

    <form action="{{ path('app_search') }}" method="get" style="margin-top:20px;">
        <input 
            type="text" 
            name="q" 
            placeholder="Nom ou EntityNumber"
            required
            style="width:100%; padding:12px; font-size:18px;"
        >

        <button style="margin-top:15px; padding:12px 20px; width:100%; font-size:18px;">
            Rechercher
        </button>
    </form>

</div>
{% endblock %}
