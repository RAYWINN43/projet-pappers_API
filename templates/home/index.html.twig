{% extends 'base.html.twig' %}
{% block body %}
<form action="{{ path('enterprise_search') }}" method="get">
    <input name="q" placeholder="Recherche">
</form>

<table>
    {% for e in enterprises %}
        {% set d = e.denominations[0] ?? null %}
        <tr>
            <td><a href="{{ path('enterprise_view', {num: e.enterpriseNumber}) }}">{{ e.enterpriseNumber }}</a></td>
            <td>{{ e.status }}</td>
            <td>{{ e.juridicalForm }}</td>
            <td>{{ d ? d.denomination : '' }}</td>
        </tr>
    {% endfor %}
</table>

<a href="{{ path('enterprise_add') }}">Ajouter</a>
{% endblock %}
