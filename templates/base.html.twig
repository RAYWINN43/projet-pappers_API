<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}{% endblock %}</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background: #f5f5f5;
        }

        h1, h2 {
            margin-bottom: 20px;
            font-weight: 600;
        }

        form div {
            margin-bottom: 15px;
        }

        input, button {
            padding: 8px;
            font-size: 16px;
        }

        button {
            cursor: pointer;
            background-color: #4a72ff;
            border: none;
            color: white;
            border-radius: 4px;
            padding: 10px 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            margin-top: 20px;
        }

        table th, table td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
        }

        a {
            text-decoration: none;
            color: #4a72ff;
        }

        .container {
            background: white;
            padding: 30px;
            border-radius: 6px;
            box-shadow: 0 0 10px rgba(0,0,0,0.08);
        }

        .back-link {
            display: inline-block;
            margin-top: 20px;
            padding: 8px 14px;
            background: #ccc;
            color: black;
            border-radius: 4px;
        }

        ul {
            background: white;
            padding: 20px;
            border-radius: 6px;
        }
    </style>
</head>

<body>
<div class="container">
    {% block body %}{% endblock %}
</div>
</body>
</html>
